# Frontend (Vite exposes only variables prefixed with VITE_)
# Publishable key for Stripe.js + Payment Element (Checkout page)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx

# Set to false to call your real API and show live Stripe Elements (default in code is mock mode)
VITE_USE_MOCK=false

# Axios base URL — must end with /api if your routes are /api/auth/..., /api/orders/...
# If your server mounts routes at the root, use http://localhost:5000 instead.
VITE_API_URL=http://localhost:5000/api

# Backend (stripe-server); never expose this key in frontend code or builds
STRIPE_SECRET_KEY=sk_test_xxxxx

# URLs for redirects and CORS (change in production)
CLIENT_URL=http://localhost:5173
STRIPE_SERVER_PORT=4242
