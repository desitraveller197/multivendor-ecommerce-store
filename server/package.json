{
  "name": "multivendor-ecommerce-server",
  "version": "1.0.0",
  "description": "Backend API for the Multivendor E-Commerce Store (MERN). Implements every REST endpoint consumed by the React frontend.",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seed/seedDatabase.js && node seed/seedSindhiProducts.js && node seed/seedCategoryProducts.js && node scripts/backfillProductFilters.js",
    "backfill-filters": "node scripts/backfillProductFilters.js",
    "test": "jest --runInBand --forceExit",
    "loadtest": "node loadtest/loadtest.js"
  },
  "keywords": [
    "mern",
    "express",
    "mongodb",
    "ecommerce",
    "multivendor"
  ],
  "license": "MIT",
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-validator": "^7.1.0",
    "google-auth-library": "^10.7.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.13",
    "pdfkit": "^0.19.1",
    "redis": "^6.1.0",
    "sanitize-html": "^2.17.5",
    "socket.io": "^4.8.3",
    "stripe": "^22.3.0"
  },
  "devDependencies": {
    "autocannon": "^8.0.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testMatch": ["**/tests/**/*.test.js"]
  }
}
