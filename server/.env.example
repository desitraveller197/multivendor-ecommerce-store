# ─── Core ───────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Database (MongoDB Atlas or local) ──────────────────
# Atlas: mongodb+srv://user:pass@cluster.mongodb.net/multivendor?retryWrites=true&w=majority
# Local: mongodb://127.0.0.1:27017/multivendor
MONGO_URI=mongodb://127.0.0.1:27017/multivendor

# ─── Auth ───────────────────────────────────────────────
JWT_SECRET=change_me_to_a_random_string_at_least_32_chars_long
JWT_EXPIRES=7d

# ─── Stripe ─────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# ─── Email (Nodemailer) ─────────────────────────────────
